ConnectionStrings__Database=Data Source=App_Data/trustmap.db;Foreign Keys=True;
Database__ApplyMigrationsOnStartup=true
Jwt__Issuer=TrustMap.Api
Jwt__Audience=TrustMap.iOS
# Development-only placeholder. Production must set Jwt__SigningKey from a secret store or environment variable.
Jwt__SigningKey=trustmap-local-development-signing-key-change-before-production
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
AppleAuth__Issuer=https://appleid.apple.com
AppleAuth__AllowedAudiences__0=com.example.trustmap
PhotoStorage__Provider=local
PhotoStorage__RootPath=storage/photos
PhotoStorage__RequestPath=/uploads

# No SMTP needed: prepares private .eml files, does not deliver email to iCloud.
Moderation__Enabled=true
Moderation__EmailProvider=file
Moderation__RecipientEmail=hubert.mar@icloud.com
Moderation__PublicBaseUrl=https://app-trust-map-g3a7egahhtdqgzae.polandcentral-01.azurewebsites.net
Moderation__EmailDirectory=App_Data/moderation-mails
Moderation__DataProtectionKeyDirectory=App_Data/moderation-keys
# Set Moderation__AdminPasswordSha256 as a hosting secret to enable account bans.
# See docs/blocking-and-reporting.md. Do not put a real digest/password here.
