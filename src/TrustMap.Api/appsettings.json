{
  "ConnectionStrings": {
    "Database": "Data Source=App_Data/trustmap.db;Foreign Keys=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "TrustMap.Api",
    "Audience": "TrustMap.iOS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AppleAuth": {
    "Issuer": "https://appleid.apple.com",
    "AllowedAudiences": [
      "com.hubert.TrustMap",
      "com.hubertik.TrustMap"
    ],
    "ClockSkewMinutes": 2
  },
  "PhotoStorage": {
    "Provider": "local",
    "RootPath": "storage/photos",
    "RequestPath": "/uploads",
    "MaxUploadBytes": 8388608,
    "OutputFormat": "jpeg",
    "JpegQuality": 85
  },
  "PushNotifications": {
    "Provider": "noop",
    "Apns": {
      "Enabled": false,
      "TeamId": "",
      "KeyId": "",
      "BundleId": "",
      "PrivateKeyBase64": "",
      "PrivateKeyPem": "",
      "PrivateKeyPath": "",
      "RequestTimeoutSeconds": 10
    }
  },
  "RateLimits": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 600,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "RefreshToken": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Upload": {
      "PermitLimit": 10,
      "WindowSeconds": 3600,
      "QueueLimit": 0
    },
    "Search": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "FriendRequests": {
      "PermitLimit": 10,
      "WindowSeconds": 3600,
      "QueueLimit": 0
    }
  },
  "Quotas": {
    "Enabled": true,
    "Uploads": {
      "MaxPhotosPerUserPerDay": 100,
      "MaxBytesPerUserPerDay": 104857600,
      "MaxAvatarChangesPerUserPerDay": 20
    },
    "Search": {
      "MaxSearchesPerUserPerDay": 5000,
      "MinimumQueryLength": 2
    },
    "FriendRequests": {
      "MaxOutgoingPerUserPerHour": 10,
      "MaxOutgoingPerUserPerDay": 50,
      "MaxPendingOutgoingPerUser": 100,
      "RejectedTargetCooldownHours": 24
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
